DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,sisuseth.com,www.sisuseth.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://sisuseth.com,https://www.sisuseth.com

# Optional: send booking-form requests to Telegram.
# 1. Create a bot with @BotFather to get the token. 2. Message the bot once.
# 3. Open https://api.telegram.org/bot<TOKEN>/getUpdates and copy "chat":{"id": ...}
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
